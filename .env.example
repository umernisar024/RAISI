# Copy this file to .env and fill in your values
# cp .env.example .env   (Mac/Linux)
# copy .env.example .env  (Windows)
#
# See PROVIDERS.md for full setup instructions for each LLM provider.

# ── Branding ──────────────────────────────────────────────────────
# These control what users see in the browser and UI.
# The internal code still uses "siagent" as variable/path names — that is fine.
APP_NAME=SI Assistant
APP_SUBTITLE=Digital Health Standards & Interoperability Assistant
APP_ICON=🏥

# ── LLM provider & model ──────────────────────────────────────────
# Change this one line to switch between providers. No code changes needed.
#
# Anthropic Claude (default):
LLM_MODEL=anthropic/claude-sonnet-4-6
#
# OpenAI:
# LLM_MODEL=openai/gpt-4o
#
# Azure OpenAI:
# LLM_MODEL=azure/your-deployment-name
#
# Ollama — fully local, no API key, no cost:
# LLM_MODEL=ollama/llama3
#
# AWS Bedrock:
# LLM_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# ── API keys (set only the one matching your LLM_MODEL above) ─────
#
# Anthropic:
ANTHROPIC_API_KEY=your-key-here
#
# OpenAI:
# OPENAI_API_KEY=your-key-here
#
# Azure OpenAI:
# AZURE_API_KEY=your-key-here
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-01
#
# Ollama: no key needed — just install Ollama and run: ollama pull llama3
#
# AWS Bedrock: uses your AWS credentials (IAM role or ~/.aws/credentials)

# ── Embedding model (no API key — runs locally) ───────────────────
# English only (default — fastest, ~90MB):
EMBEDDING_MODEL=all-MiniLM-L6-v2
#
# Multilingual options (switch to one of these if your documents are not English):
# EMBEDDING_MODEL=intfloat/multilingual-e5-small   # fast, ~120MB, 100+ languages
# EMBEDDING_MODEL=intfloat/multilingual-e5-large   # slower, ~560MB, best quality
#
# NOTE: if you change this after ingestion, delete data/chroma_db/ and re-ingest —
# embeddings from different models are not compatible.

# ── ChromaDB (local vector store) ────────────────────────────────
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION=digital_health_kb

# ── Chunking settings ─────────────────────────────────────────────
CHUNK_SIZE=512          # tokens per chunk
CHUNK_OVERLAP=64        # overlap between chunks

# ── RAG retrieval ─────────────────────────────────────────────────
RAG_N_RESULTS=5             # number of chunks to retrieve per query
RETRIEVAL_HISTORY_TURNS=2   # recent turns blended into the retrieval query

# ── Storage backend ───────────────────────────────────────────────
# local  → reads from data/raw/ (default, for local dev and testing)
# s3     → downloads from AWS S3 (for production on AWS)
STORAGE_BACKEND=local

# ── AWS S3 (only required when STORAGE_BACKEND=s3) ────────────────
# AWS_BUCKET_NAME=your-bucket-name
# AWS_PREFIX=documents/
# AWS_REGION=us-east-1
#
# Credentials: use IAM role (recommended on EC2/ECS) or:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Rate limiting ─────────────────────────────────────────────────
# Max questions per user per day. 0 = unlimited. Admin users always exempt.
DAILY_QUESTION_LIMIT=50
# Timezone for daily reset — counts reset at midnight in this timezone
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones for valid values
RATE_LIMIT_TIMEZONE=Australia/Sydney

# ── Session security ──────────────────────────────────────────────
# Auto-logout after this many minutes of inactivity. Default: 120 (2 hours).
SESSION_TIMEOUT_MINUTES=120

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
